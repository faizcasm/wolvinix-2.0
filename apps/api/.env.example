# Copy to apps/api/.env — required values are JWT_SECRET (and MONGODB_URI for a remote DB).

# --- core ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma separated list of allowed browser origins (CORS, credentials enabled).
# The Vite dev server runs on :3000 — add your production domain here.
CLIENT=http://localhost:3000,http://localhost:5173

# REQUIRED — at least 32 chars: openssl rand -hex 32
JWT_SECRET=

# Session cookie (httpOnly, SameSite). Secure is forced in production.
COOKIE_NAME=jwt
COOKIE_SAMESITE=lax
JWT_EXPIRES_IN=7d

# Lifetime of the socket handshake ticket in seconds
SOCKET_TICKET_TTL=60

# --- database ------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/wolvinix

# --- cloudinary (optional; /api/media/upload needs it) -------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- mail (optional; forgot-password OTP + contact form) -----------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Wolvinix <no-reply@wolvinix.app>"
MAIL_TO=
