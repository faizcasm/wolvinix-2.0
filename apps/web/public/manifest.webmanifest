{
  "name": "Wolvinix — Social Network for Gamers",
  "short_name": "Wolvinix",
  "description": "Share clips, form clans, track game stats, chat in real time and climb the leaderboard.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#07070d",
  "theme_color": "#07070d",
