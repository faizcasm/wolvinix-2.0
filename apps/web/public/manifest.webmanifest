  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Feed", "url": "/" },
    { "name": "Messages", "url": "/messages" },
    { "name": "Clans", "url": "/clans" },
    { "name": "Leaderboard", "url": "/leaderboard" }
  ]
}
